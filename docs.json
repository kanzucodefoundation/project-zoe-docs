  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:info@kanzucodefoundation.org"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/kanzucodefoundation/project-zoe-server"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/kanzucodefoundation"
    }
