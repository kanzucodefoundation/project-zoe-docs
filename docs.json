{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Project Zoe",
  "colors": {
    "primary": "#16A34A",
    "light": "#4ADE80",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
