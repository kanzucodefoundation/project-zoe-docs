            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/multi-tenancy",
              "concepts/group-hierarchy",
              "concepts/authentication"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "features/people",
              "features/groups",
              "features/events",
              "features/attendance",
              "features/finance",
              "features/reports",
              "features/tasks"
            ]
          },
          {
            "group": "Developer Guide",
            "pages": [
              "developer/server-setup",
              "developer/client-setup",
              "developer/database",
              "developer/contributing"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API",
            "pages": [
              "developer/api/overview",
              "developer/api/authentication",
              "developer/api/contacts",
